# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.rc text eol=lf
*.nsi text eol=lf
Makefile text eol=lf

# Windows-specific scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.zip binary
*.tar.gz binary
*.dmg binary
*.apk binary
*.keystore binary
