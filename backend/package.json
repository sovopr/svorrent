{
  "name": "backend",
  "version": "1.0.3",
  "description": "Svorrent BitTorrent daemon and network bonding engine",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --openssl-legacy-provider server.js",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-local.js",
    "build:dmg": "../scripts/build-dmg.sh",
    "build:win": "../scripts/build-windows.sh",
    "build:tether": "make -C tether",
    "setup:tether": "sudo ./scripts/install-tetherd.sh",
    "uninstall:tether": "sudo ./scripts/uninstall-tetherd.sh"
  },
  "keywords": ["bittorrent", "network-bonding", "tethering", "streaming"],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bittorrent-peerid": "^2.0.2",
    "express": "^5.3.0",
    "geoip-lite": "^2.0.3",
    "torrent-search-api": "^2.1.4",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "bittorrent-tracker": "^11.2.3"
  }
}
